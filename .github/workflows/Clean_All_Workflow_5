name: Clean_All_Workflow
on:
  workflow_dispatch:
jobs:
  clean:
    runs-on: ubuntu-latest
    permissions:
      actions: write
      contents: read
    steps:
      - name: All workflows keep 5 runs
        uses: Mattraks/delete-workflow-runs@v2
        with:
          token: ${{ github.TOKEN }}
          repository: ${{ github.repository }}
          retain_days: 0
          keep_minimum_runs: 5
